// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Card {
  id        Int      @id @default(autoincrement())
  cidade    String
  atividade String
  temp      Float
  // NOVOS CAMPOS ---
  umidade   Int      @default(0)
  vento     Float    @default(0.0)
  descricao String   @default("Não informado") 
  // ----------------
  status    Boolean
  mensagem  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Histórico de Operações (Log de auditoria)
model Historico {
  id        Int      @id @default(autoincrement())
  acao      String   // "CRIAR", "ATUALIZAR", "DELETAR"
  detalhe   String   // Ex: "Card ID 5 criado para cidade Londres"
  data      DateTime @default(now())
}

// Tabela auxiliar apenas para listar opções disponíveis no Frontend (Seed)
model AtividadeDisponivel {
  nome String @id
}